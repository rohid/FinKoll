# Copy this file to .env and fill in every value before running.
# Generate strong random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# JWT signing secret — minimum 32 characters, use a random hex string
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# AES-256 database encryption key — must be EXACTLY 32 characters
DB_ENCRYPTION_KEY=change-me-to-a-32-char-key!!!!!!

ADMIN_USERNAME=admin

# Generate the hash:
#   cd backend && npm install
#   node -e "const b=require('bcryptjs'); b.hash('yourpassword',12).then(console.log)"
#
# IMPORTANT for Docker Compose: every $ in the hash must be written as $$
# Example — if the hash is:  $2a$12$abc...
# Write it as:               $$2a$$12$$abc...
# Docker Compose unescapes $$ → $ before passing it to the container.
ADMIN_PASSWORD_HASH=

# URL the browser uses to reach the app — used for CORS origin validation.
# For Raspberry Pi on local network, set this to your Pi's IP or hostname.
# Example: http://192.168.1.50:5173
# Example: http://finkoll.local:5173
FRONTEND_URL=http://localhost:5173
